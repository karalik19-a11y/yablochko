{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YABLOKO INTELLIGENCE",
  "version": "0.2.0",
  "identifier": "ru.yabloko.intelligence",
  "build": {
    "frontendDist": "../../../apps/web-dev/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YABLOKO INTELLIGENCE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "copyright": "Аналитическая платформа партии «ЯБЛОКО». SYNTHETIC-данные до импорта официальных источников.",
    "shortDescription": "YABLOKO INTELLIGENCE",
    "longDescription": "Аналитическая desktop-платформа партии «ЯБЛОКО»: метрики территорий, выборы, реестр позиций, медиа, OSINT, Decision Lab. Данные SYNTHETIC (grade D) до импорта официальных источников.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
