{
  "name": "yablochko",
  "private": true,
  "version": "0.2.0",
  "description": "YABLOKO INTELLIGENCE — аналитическая платформа (Party Intelligence / Public Data Intelligence)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_OPTIONS=--no-warnings tsx services/dev-api/src/server.ts",
    "dev:web": "vite --config apps/web-dev/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/web-dev/vite.config.ts",
    "start": "NODE_OPTIONS=--no-warnings tsx services/dev-api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/domain && tsc --noEmit -p packages/api-contract && tsc --noEmit -p packages/data-access && tsc --noEmit -p packages/ingest && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/app && tsc --noEmit -p services/dev-api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
